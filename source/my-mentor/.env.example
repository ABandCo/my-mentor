# Copy to .env and fill in. Never commit .env.
# Public values (safe inside the app):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only secrets — set these as Supabase Edge Function secrets, NOT here in the app:
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   (adapter disabled)
# OPENAI_API_KEY=      (adapter disabled)
# PERPLEXITY_API_KEY=  (adapter disabled)
